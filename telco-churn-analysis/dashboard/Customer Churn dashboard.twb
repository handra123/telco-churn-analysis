      <aliases enabled='yes' />
      <column caption='Tanure Group' datatype='string' name='[Calculation_1276288886722562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0-12 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13-24 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 36 THEN &quot;25-36 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;37-48 months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 60 THEN &quot;49-60 months&quot;&#13;&#10;ELSE &quot;61-72 months&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Flag' datatype='integer' name='[Calculation_1276288887222275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_1276288887328772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1276288887222275]) / COUNTD([customerID])' />
      </column>
      <column caption='Senior Label' datatype='string' name='[Calculation_1276288970223624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SeniorCitizen] = 1 THEN &quot;Senior Citizen&quot; ELSE &quot;Non Senior Citizen&quot; END' />
      </column>
      <column datatype='string' name='[Churn]' role='dimension' type='nominal' />
